# ============================================
# APPLICATION
# ============================================
APP_NAME=CabaaCabaa
APP_ENV=local
APP_KEY=base64:lfV8HIdcF0+KcgCgJG/EcmNL1SRZf6QgdXwPbe5eUjQ=
APP_DEBUG=true
APP_URL=http://localhost

# Localisation (fr pour français)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# BASE DE DONNÉES - SQLITE
# ============================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cabaacabaa
# DB_USERNAME=root
# DB_PASSWORD=

# Options MySQL (optionnel)
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ============================================
# SESSIONS, CACHE & QUEUE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# ============================================
# REDIS (optionnel)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# EMAIL
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@cabaacabaa.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# PAIEMENTS - QOSIC/QOSPAY
# ============================================
# URL de l'API Qosic pour les paiements mobile money
QOSPAY_REQUEST_URL=https://api.qosic.net/QosicBridge/user/requestpayment

# Identifiants Qosic (à obtenir sur votre compte Qosic)
QOSPAY_LOGIN=
QOSPAY_PASSWORD=
QOSPAY_CLIENT_ID=

# ============================================
# PAIEMENTS - CINETPAY
# ============================================
# Identifiants CinetPay (à obtenir sur cinetpay.com)
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# Mode: sandbox (test) ou live (production)
CINETPAY_MODE=sandbox

# ============================================
# PAIEMENTS - FEDAPAY
# ============================================
# Clé API FedaPay (à obtenir sur fedapay.com)
FEDAPAY_API_KEY=

# Mode: sandbox (test) ou live (production)
FEDAPAY_MODE=sandbox

# ============================================
# CARTES & LOCALISATION
# ============================================
# Clé API Google Maps (pour géolocalisation et cartes)
# Obtenir sur: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Clé API Mapbox (alternative à Google Maps)
# Obtenir sur: https://www.mapbox.com/
MAPBOX_API_KEY=

# Frais de livraison par défaut (en FCFA)
DEFAULT_DELIVERY_FEE=500

# ============================================
# SEO & ANALYTICS
# ============================================
# Google Analytics Measurement ID (ex: G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=

# Meta tags par défaut
META_TITLE="CabaaCabaa - Votre marketplace locale"
META_DESCRIPTION="Découvrez les meilleurs commerces près de chez vous : restaurants, boutiques, épiceries et plus. Livraison, emporter ou sur place."
META_KEYWORDS="marketplace, commerce local, restaurant, boutique, épicerie, livraison, emporter, sur place, Togo, Bénin, Afrique"

# ============================================
# INFORMATIONS DU SITE
# ============================================
SITE_NAME=CabaaCabaa
SITE_CONTACT_EMAIL=contact@cabaacabaa.com
SITE_CONTACT_PHONE="+229 00 00 00 00"
SYSTEM_CURRENCY=XOF

# ============================================
# BRANDING (URLs externes)
# ============================================
# Si vos logos sont hébergés sur un CDN externe
SITE_LOGO_URL=
SITE_FAVICON_URL=

# ============================================
# EMAIL TEMPLATES (optionnel)
# ============================================
# Ces paramètres peuvent aussi être gérés via l'admin
EMAIL_VENDOR_APPROVED_SUBJECT="Votre boutique est maintenant active ! 🚀"
EMAIL_VENDOR_APPROVED_BODY="Félicitations ! Votre compte vendeur a été validé par notre équipe."

# ============================================
# AWS (si utilisé pour stockage S3)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# REVERB (WebSockets - Laravel Reverb)
# ============================================
# Configuration pour les notifications en temps réel
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ============================================
# PUSHER (alternative à Reverb)
# ============================================
# Si vous utilisez Pusher au lieu de Reverb
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ============================================
# VITE (Build Frontend)
# ============================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# NOTES DE CONFIGURATION
# ============================================
# 1. Copier ce fichier vers .env: cp .env.example .env
# 2. Générer une clé d'application: php artisan key:generate
# 3. Configurer votre base de données MySQL
# 4. Exécuter les migrations: php artisan migrate
# 5. Remplir les données de base: php artisan db:seed
# 6. Configurer les clés API de paiement et cartes
# 7. Compiler les assets: npm install && npm run build
